<file path=".github/workflows/deploy.yml">
name: CI/CD

on:
  push:
    branches: [ "main", "feature/*" ]

jobs:
  deploy-local:
    runs-on: self-hosted

    steps:
      - name: Descargar Código
        uses: actions/checkout@v4

      - name: Limpieza Previa
        run: docker compose down -v --remove-orphans
        continue-on-error: true

      - name: Configurar Secretos
        env:
          SEC_DB_NAME: ${{ secrets.DB_NAME }}
          SEC_DB_USER: ${{ secrets.DB_USER }}
          SEC_DB_PASS: ${{ secrets.DB_PASSWORD }}
          SEC_ROOT_PASS: ${{ secrets.MYSQL_ROOT_PASSWORD }}
        run: |
          $root = Get-Location
          $secretsPath = Join-Path $root "secrets"
          $initPath = Join-Path $root "mysql-init"

          if (Test-Path $secretsPath) {
              Remove-Item -Path $secretsPath -Recurse -Force
          }

          New-Item -ItemType Directory -Force -Path $secretsPath | Out-Null
          New-Item -ItemType Directory -Force -Path $initPath | Out-Null

          $files = @{
              "db_name.txt"          = $env:SEC_DB_NAME
              "db_user.txt"          = $env:SEC_DB_USER
              "db_password.txt"      = $env:SEC_DB_PASS
              "db_root_password.txt" = $env:SEC_ROOT_PASS
          }

          foreach ($name in $files.Keys) {
              $path = Join-Path $secretsPath $name
              
              if (-not [string]::IsNullOrWhiteSpace($files[$name])) {
                  [System.IO.File]::WriteAllText($path, $files[$name])
              } else {
                  Write-Error "Error: Secreto vacio para $name"
                  exit 1
              }
          }

          $sqlContent = "GRANT ALL PRIVILEGES ON $($env:SEC_DB_NAME).* TO '$($env:SEC_DB_USER)'@'%'; FLUSH PRIVILEGES;"
          $sqlPath = Join-Path $initPath "init.sql"
          [System.IO.File]::WriteAllText($sqlPath, $sqlContent)

      - name: Ejecutar Pruebas en Docker
        run: |
          docker compose build web
          docker compose run --rm --entrypoint "sh -c" web "pip install pytest httpx coverage && export PYTHONPATH=/app && pytest tests/ -v"

      - name: Despliegue Final o Apagado
        if: always()
        run: |
          docker compose down --remove-orphans
          
          docker ps --filter "publish=3307" -q | ForEach-Object { docker rm -f $_ }
          docker ps --filter "publish=8000" -q | ForEach-Object { docker rm -f $_ }
          docker ps --filter "publish=8501" -q | ForEach-Object { docker rm -f $_ }
          
          Start-Sleep -Seconds 5
          
          docker compose up -d --build
          docker image prune -f
</file>

